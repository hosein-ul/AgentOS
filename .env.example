# Server-only Supabase credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to a browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Optional alias used by the standalone gateway.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Legacy Supabase JWT secret is retained only for migration compatibility.
SUPABASE_JWT_SECRET=""

# Public canonical HTTPS URL; x402 requirements bind to this exact URL.
APP_URL="https://api.example.com"

# Private owner administration (HTTP Basic Auth, required for /admin and legacy admin routes).
ADMIN_DASHBOARD_USERNAME=""
ADMIN_DASHBOARD_PASSWORD=""

# HMAC secret for the public wallet-owner dashboard session. Generate at least
# 32 random bytes; dashboard sessions expire after 12 hours and are not API tokens.
DASHBOARD_SESSION_SECRET=""

# Resend. EMAIL_DOMAIN must be verified in Resend before mailbox creation or sending.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_DOMAIN="agents.example.com"

# OKX x402 production settlement. PAYMENT_REQUIRED must remain true in any public deployment.
PAYMENT_REQUIRED="true"
PAYMENT_WALLET="0x0000000000000000000000000000000000000000"
OKX_API_KEY=""
OKX_SECRET_KEY=""
OKX_PASSPHRASE=""

# AgentPhone production API and signed webhook ingress.
AGENTPHONE_API_KEY=""
AGENTPHONE_BASE_URL="https://api.agentphone.ai"

# Exactly 32 random bytes base64-encoded; encrypts AgentOS callback and AgentPhone webhook secrets.
PHONE_SECRET_ENCRYPTION_KEY=""

# Protects the durable worker endpoint. Vercel sends this as Authorization: Bearer.
CRON_SECRET=""

# Separate persistent WebSocket gateway (Vercel Functions cannot host it).
# Public wss:// URL handed to agents in the realtime-token response.
REALTIME_GATEWAY_URL="wss://events.example.com/v1/events"
# Signs the 15-minute realtime tokens agents use for session.authenticate.
REALTIME_GATEWAY_JWT_SECRET=""

# Live-voice broker hop: AgentOS -> gateway, server to server. Not public.
# Base origin of the gateway's HTTP listener; AgentOS posts to /internal/voice/turn.
REALTIME_GATEWAY_INTERNAL_URL="https://events.example.com"
# Shared HMAC secret for that hop. At least 32 characters. Distinct from the JWT secret.
REALTIME_GATEWAY_INTERNAL_SECRET=""

# Separate continuously running durable-worker process.
AGENTOS_APP_URL="https://api.example.com"
WORKER_INTERVAL_MS="5000"

# Domain is unavailable. Cloudflare-backed support is planned but not implemented.
# Leave these unset: they belong to an unused legacy adapter and setting them does
# not enable Domain. /api/v1/domains/register returns 503 regardless.
NAMECHEAP_API_USER=""
NAMECHEAP_API_KEY=""
NAMECHEAP_USERNAME=""
NAMECHEAP_CLIENT_IP=""
NAMECHEAP_SANDBOX="false"
DOMAIN_CONTACT_ENCRYPTION_KEY=""
